# ATP v6.3.15 credentials and fronts
ATP_BROKER_ID=
ATP_USER_ID=
ATP_PASSWORD=
ATP_FRONT_MD=tcp://127.0.0.1:41213
ATP_FRONT_TD=tcp://127.0.0.1:40905

# Optional startup subscriptions
ATP_ENABLE_MD=true
ATP_SYMBOLS=

# ZeroMQ endpoints
ZMQ_BIND_HOST=0.0.0.0
ZMQ_PUB_PORT=5585
ZMQ_REP_PORT=5586

# ATP query serialization and snapshots
ATP_QUERY_MIN_INTERVAL_SECONDS=1.0
ATP_QUERY_TIMEOUT_SECONDS=10.0
ATP_SNAPSHOT_TTL_SECONDS=5.0

# PostgreSQL order persistence
DATABASE_URL=postgresql://atp_proxy:atp_proxy_change_me@127.0.0.1:5432/atp_proxy
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Used by docker-compose.yml
POSTGRES_DB=atp_proxy
POSTGRES_USER=atp_proxy
POSTGRES_PASSWORD=atp_proxy_change_me

# Runtime state
ATP_FLOW_PATH=flow

# Logging
LOG_LEVEL=INFO
LOG_BACKUP_COUNT=30
LOG_DIR=logs
